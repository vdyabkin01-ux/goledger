# Copy to .env and adjust: cp .env.example .env
# .env is gitignored — never commit real secrets.

PORT=8080

# Local dev database from docker-compose.yml
DATABASE_URL=postgres://goledger:goledger@localhost:5432/goledger?sslmode=disable

# At least 32 characters. Generate one: openssl rand -hex 32
JWT_SECRET=replace-me-with-output-of-openssl-rand-hex-32

# Access token lifetime (Go duration: 15m, 1h, 24h)
JWT_TTL=1h
